{
  "name": "bcourses-student-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A student-scoped MCP server for UC Berkeley bCourses (Canvas LMS).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/stdio.ts",
    "dev:http": "tsx src/http.ts",
    "start": "node dist/src/stdio.js",
    "start:http": "node dist/src/http.js",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
